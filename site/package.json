{
  "name": "nickcapobianco-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Personal portfolio of Nick Capobianco. Next.js static export, published to the repository root for GitHub Pages.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "publish": "next build && node scripts/publish.mjs",
    "start": "npx serve@14 out",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
